# Server
HOST=0.0.0.0
PORT=8000

# DuckDNS + HTTPS (Let's Encrypt)
# 1. Creer un compte sur https://www.duckdns.org
# 2. Creer un sous-domaine et copier le token
DOMAIN=scalping-radar.duckdns.org
DUCKDNS_TOKEN=

# Authentification (laisser vide = acces libre)
# Option 1 : un seul utilisateur
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
# Option 2 : plusieurs utilisateurs (format user:pass,user2:pass2)
# Les usernames peuvent etre des emails (le dernier ":" separe login et password)
AUTH_USERS=couderc.xavier@gmail.com:motdepasse1,c.chaussis@icloud.com:motdepasse2
# Noms d'affichage par utilisateur (format user:DisplayName,user2:DisplayName2)
# Si absent, le prefixe avant @ est utilise (ex: couderc.xavier pour email)
AUTH_DISPLAY_NAMES=couderc.xavier@gmail.com:Xav,c.chaussis@icloud.com:Ced

# Scraping intervals (seconds)
# Twelve Data gratuit (800 req/jour) : garder 10 paires @ 300s depasse la limite.
# Configuration recommandee pour plan gratuit : 2 paires @ 180s = ~960 req/j (tolere).
# Configuration recommandee pour plan Grow : 10 paires @ 180s = 4800 req/j (sous 5000).
MATAF_POLL_INTERVAL=180
FOREXFACTORY_POLL_INTERVAL=600

# Analysis thresholds
VOLATILITY_THRESHOLD_HIGH=1.5
VOLATILITY_THRESHOLD_MEDIUM=1.2
TREND_STRENGTH_MIN=0.6

# Source de prix :
#   "twelvedata" = API REST (gratuit 800 req/jour, polling 1min min)
#   "mt5"        = MetaTrader 5 en temps reel (requiert MT5 desktop + lib MetaTrader5)
PRICE_SOURCE=twelvedata

# --- Option 1 : Twelve Data API ---
# Gratuit: 8 req/min, 800/jour. Inscription https://twelvedata.com/register
# Sans cle, l'outil fonctionne avec des donnees simulees.
TWELVEDATA_API_KEY=

# WebSocket Twelve Data : ticks temps reel <1s (requiert plan Grow ou plus)
# Limite reelle du plan Grow = 2 symboles simultanes en WebSocket.
# Pour streamer plus, passer au plan Pro (jusqu'a 80 symboles).
TWELVEDATA_WS_ENABLED=false
TWELVEDATA_WS_MAX_SYMBOLS=2

# --- Telegram bot (notifications mobiles des signaux) ---
# 1. Parler a @BotFather sur Telegram -> /newbot -> copier le token
# 2. Envoyer "bonjour" a votre bot depuis votre compte Telegram
# 3. Ouvrir https://api.telegram.org/bot<TOKEN>/getUpdates pour recuperer chat_id
TELEGRAM_BOT_TOKEN=
# --- Mode 1 (simple) : un seul destinataire ---
TELEGRAM_CHAT_ID=
# --- Mode 2 (multi-users avec silent mode par user) ---
# Chaque user a son propre chat_id, son silent mode est verifie independamment.
# Format: user1:chat_id1,user2:chat_id2 (le user doit matcher celui dans AUTH_USERS)
# Si renseigne, TELEGRAM_CHAT_ID est ignore.
TELEGRAM_CHATS=
# Force minimum pour envoi Telegram : weak / moderate / strong
TELEGRAM_MIN_STRENGTH=strong

# --- Option 2 : MetaTrader 5 (temps reel) ---
# Requiert : MT5 desktop installe et lance + pip install MetaTrader5
# Le terminal MT5 doit etre lance sur la meme machine que le radar.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Chemin vers terminal64.exe (optionnel si MT5 est deja lance)
# Windows : C:\Program Files\OANDA TMS Brokers MT5\terminal64.exe
MT5_TERMINAL_PATH=
# Mapping paires -> symboles broker (obligatoire pour OANDA TMS et autres brokers a suffixe)
# Exemple OANDA TMS : XAU/USD:GOLD.pro,EUR/USD:EURUSD.pro,GBP/USD:GBPUSD.pro,USD/JPY:USDJPY.pro
MT5_SYMBOL_MAP=

# Money management
TRADING_CAPITAL=10000
RISK_PER_TRADE_PCT=1.0
MIN_CONFIDENCE_SCORE=75

# Intervalle des bougies pour l'analyse de patterns
CANDLE_INTERVAL=5min
CANDLE_COUNT=50

# Paires surveillees (ajuster selon le plan Twelve Data)
# Plan gratuit (800 req/j) : max 2 paires @ 180s de polling
# Plan Grow 29$/mo (5000 req/j) : jusqu'a 10 paires @ 180s
# Plan Pro 79$/mo : 10+ paires @ 60s possible
WATCHED_PAIRS=XAU/USD,EUR/USD
# Panier complet (necessite plan Grow minimum) :
# WATCHED_PAIRS=XAU/USD,EUR/USD,GBP/USD,USD/JPY,EUR/GBP,USD/CHF,AUD/USD,USD/CAD,EUR/JPY,GBP/JPY

# --- Email summary quotidien (optionnel) ---
# Envoie un recap a 22h UTC chaque jour. Compatible Gmail/Sendgrid/etc.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
# Plusieurs destinataires separes par virgule
EMAIL_RECIPIENTS=

# Macro context scoring (Vague 1)
MACRO_SCORING_ENABLED=false
MACRO_VETO_ENABLED=false
MACRO_REFRESH_INTERVAL_SEC=900
MACRO_CACHE_MAX_AGE_SEC=7200

# Multi-asset supports (observation only until broker migration)
# WATCHED_PAIRS default now includes crypto + indices + commodities from Twelve Data Grow
# Override example:
# WATCHED_PAIRS=XAU/USD,EUR/USD,USD/JPY,BTC/USD,ETH/USD,SPX,NDX
# ASSET_CLASS_OVERRIDES="MY/PAIR:crypto,CUSTOM:equity_index"

# --- Auto-trader IBKR v1 (2026-11-11) ---
# Pipeline end-to-end sans intervention humaine : screener → vetos → budget
# → risk → exec via bridge IBKR. OFF par défaut, mode dry_run par défaut.
AUTO_TRADER_ENABLED=false
# Mode : "dry_run" (log seulement, aucun ordre) ou "live" (ordres réels).
# Même en "live", le bridge refuse si IBKR_ALLOW_ORDERS=false (double verrou).
AUTO_TRADER_MODE=dry_run
# Univers restreint (5 tickers US liquides pour commencer)
AUTO_TRADER_UNIVERSE=AAPL,TSLA,F,SPY,QQQ
# Garde-fous
AUTO_TRADER_MAX_DAILY_LOSS_EUR=5.0
AUTO_TRADER_MAX_POSITIONS=3
AUTO_TRADER_MAX_ORDER_EUR=20.0
AUTO_TRADER_MIN_CONFIDENCE=70.0
# Bracket order baseline (% distance SL/TP vs entry)
AUTO_TRADER_SL_PCT=2.0
AUTO_TRADER_TP_PCT=4.0
# EUR→USD pour le sizing (fixe, à updater manuellement de temps en temps)
AUTO_TRADER_EUR_USD_FIXED=1.07
# Vetos
AUTO_TRADER_EARNINGS_WINDOW_HOURS=48
AUTO_TRADER_FOMC_WINDOW_MINUTES=120
# Blackout vendredi soir UTC (20h30 Paris = 19h30 UTC en CET, 18h30 en CEST)
AUTO_TRADER_FRIDAY_LATE_BLOCK_UTC=19:30
# Interval de scan en secondes (300 = 5 min)
AUTO_TRADER_SCAN_INTERVAL_SEC=300
# Silence les rapports de cycle 5min + daily recap + résumé closures.
# N'affecte PAS les OPEN/CLOSE de trades ni les alertes critiques
# (daily loss kill, friday force-close).
AUTO_TRADER_SILENCE_CYCLES=false

# --- Mean reversion FX via MT5 bridge (2026-11-11) ---
# Stratégie contre-trend après pic de volatilité sur paires forex.
# Filtres : BBW percentile > 80 (1h), ATR > 2× moyenne (1h),
# bougie trigger > 2.5× ATR + reversal (15min). Target = VWAP du jour,
# time stop 4h. Sizing : 0.5% du balance MT5 par trade.
MEANREV_ENABLED=false
# Mode : "dry_run" (log seulement) ou "live" (ordres MT5 réels)
MEANREV_MODE=live
# URL du bridge MT5 (Tailscale IP du PC Lightsail hébergeant MT5)
MEANREV_BRIDGE_URL=http://100.74.160.72:8787
# Clé API bridge (si configurée). Laisser vide si pas d'auth.
MEANREV_BRIDGE_API_KEY=
# Univers (laisser vide pour hériter de WATCHED_PAIRS)
MEANREV_UNIVERSE=
# Gates
MEANREV_MAX_DAILY_LOSS_EUR=10.0
MEANREV_MAX_POSITIONS=5
MEANREV_RISK_PCT=0.5
# Seuils stratégie
MEANREV_BBW_PERCENTILE_MIN=80
MEANREV_ATR_EXPANSION_MIN=2.0
MEANREV_TRIGGER_CANDLE_MULT=2.5
# Time stop en minutes (4h = 240)
MEANREV_TIME_STOP_MINUTES=240
# Blackout vendredi soir UTC
MEANREV_FRIDAY_LATE_BLOCK_UTC=19:30
# Interval de scan en secondes (900 = 15min)
MEANREV_SCAN_INTERVAL_SEC=900
# State path
MEANREV_STATE_PATH=/app/data/meanrev_state.json
# Silence les rapports de cycle 15min + daily recap + résumé check_exits.
# N'affecte PAS les cartes riches OPEN/CLOSE ni les alertes critiques
# (bridge unreachable, daily loss kill, friday force-close).
MEANREV_SILENCE_CYCLES=false

# --- Veille positions IBKR (cockpit unifié multi-broker) ---
# Poll le bridge IBKR périodiquement, détecte drawdown / nouvelles positions /
# bridge silencieux, push Telegram. OFF par défaut.
COCKPIT_IBKR_WATCH_ENABLED=false
# URL du bridge IBKR (Tailscale IP du PC Windows Lightsail hébergeant le bridge)
IBKR_BRIDGE_URL=http://100.74.160.72:8792
# Intervalle de polling (secondes). 60s = 1440 req/jour, trivial pour le bridge.
COCKPIT_IBKR_POLL_SEC=60
# Alerte si daily PnL / NetLiquidation < -<pct>%
COCKPIT_IBKR_DAILY_DD_ALERT_PCT=5.0
# Alerte si plus de <n> positions ouvertes simultanément
COCKPIT_IBKR_MAX_OPEN_POSITIONS=10
# Alerte critical si le bridge n'a pas répondu depuis <sec> secondes
COCKPIT_IBKR_BRIDGE_SILENCE_ALERT_SEC=300

# --- trader-skill relay (push Telegram depuis les skills Claude) ---
# Clé partagée entre backend/app.py et trader/notify.py. Si vide :
# l'endpoint /api/trader-skill-event renvoie 404 et notify_radar() devient
# un no-op silencieux. Générer avec : python -c 'import secrets; print(secrets.token_urlsafe(32))'
TRADER_SKILL_WEBHOOK_KEY=
# URL du radar vue depuis la machine qui exécute les skills Claude.
# En local pointez sur https://scalping-radar.duckdns.org (ou http://localhost:8000
# si vous travaillez en dev).
TRADER_SKILL_RADAR_URL=https://scalping-radar.duckdns.org

# --- Horizon d'analyse et vetos evenementiels (2026-08-05) ---
# Canal Telegram dedie au flux long-horizon (4h/1d) : TELEGRAM_SETUP_VERDICTS
# est vide en production (~2000 msg/j sinon), ce canal reste ouvert car le
# flux 4h/1d ne pese que quelques setups par jour.
TELEGRAM_LONG_HORIZON_ENABLED=true
# Score de confiance minimum pour qu'un setup long-horizon soit notifie sur
# ce canal (0-100).
TELEGRAM_LONG_HORIZON_MIN_CONFIDENCE=61
# Bloque l'ouverture d'une detention longue (4h/1d) qui traverserait la
# cloture du week-end : une position ouverte vendredi soir franchit le gap
# de reouverture par construction. Independant du gel energie preexistant
# (NO_FRIDAY_LATE_OPEN_ENERGY_*), qui reste actif en parallele.
WEEKEND_HOLD_BLOCK_ENABLED=true

# --- Scalping intraday IC Markets (2026-11-13) ---
# Stratégie contre-trend RSI/ATR sur candles 1min, vise ~15-30 setups/jour
# sur 4 paires FX. Tourne en parallèle de meanrev momentum (différents
# régimes de marché). SL=1×ATR, TP=1.5×ATR, time stop 60min.
SCALP_ENABLED=false
# Mode : "dry_run" (log seulement) ou "live" (ordres MT5 réels)
SCALP_MODE=dry_run
# Bridge MT5 (même que meanrev par défaut)
SCALP_BRIDGE_URL=http://100.74.160.72:8787
# Clé API bridge (fallback sur MT5_BRIDGE_API_KEY si vide)
SCALP_BRIDGE_API_KEY=
# Compte demo → canal Telegram demo 🟦 ; false → canal ic_markets 🟩
SCALP_ACCOUNT_IS_DEMO=true
# Univers (4 paires = ~15-30 TAKE/jour attendus en dry_run)
SCALP_UNIVERSE=XAU/USD,EUR/USD,GBP/USD,USD/JPY
# Gates
SCALP_MAX_DAILY_LOSS_EUR=15.0
SCALP_MAX_POSITIONS=10
SCALP_RISK_PCT=0.25
# Seuils RSI
SCALP_RSI_PERIOD=14
SCALP_RSI_LONG_THR=30
SCALP_RSI_SHORT_THR=70
# SL/TP basés sur ATR
SCALP_SL_ATR_MULT=1.0
SCALP_TP_R_MULT=1.5
SCALP_ATR_PERIOD=14
# Direction (false = mean reversion, true = momentum / continuation).
# Flag miroir de MEANREV_INVERT_DIRECTION (PR #23). Permet de tester les 2
# approches sans toucher le code : si MR donne 100% SL sur une paire
# trending, passer ce flag à true (le code inverse la direction et utilise
# un TP R:R symétrique via MOMENTUM_TP_R_MULT au lieu du TP basé ATR).
SCALP_INVERT_DIRECTION=false
# Multiplicateur R:R quand INVERT_DIRECTION=true (TP = entry ± N × distance_SL
# dans la direction du trade momentum).
SCALP_MOMENTUM_TP_R_MULT=2.0
# Time stop en minutes
SCALP_TIME_STOP_MINUTES=60
SCALP_FRIDAY_LATE_BLOCK_UTC=19:30
# Cadence du cycle (60s = toutes les minutes)
SCALP_SCAN_INTERVAL_SEC=60
SCALP_STATE_PATH=/app/data/scalp_state.json

# --- Daily swing trader (2026-11-13) ---
# Pipeline sur candles 1d, hold 1-5 jours. Cible ~1-3 trades/semaine/paire.
# Scan 1×/jour à 22h UTC après close NYSE. SL/TP wide (2× ATR) pour swing.
DAILY_ENABLED=false
DAILY_MODE=dry_run
DAILY_BRIDGE_URL=http://100.74.160.72:8787
DAILY_BRIDGE_API_KEY=
DAILY_ACCOUNT_IS_DEMO=true
DAILY_UNIVERSE=XAU/USD,EUR/USD,GBP/USD,USD/JPY
DAILY_MAX_DAILY_LOSS_EUR=20.0
DAILY_MAX_POSITIONS=5
DAILY_RISK_PCT=0.5
DAILY_RSI_PERIOD=14
DAILY_RSI_LONG_THR=30
DAILY_RSI_SHORT_THR=70
# SL/TP wide pour swing (défaut industrie pour daily)
DAILY_SL_ATR_MULT=2.0
DAILY_TP_R_MULT=2.0
DAILY_ATR_PERIOD=14
DAILY_INVERT_DIRECTION=false
DAILY_MOMENTUM_TP_R_MULT=2.0
# Time stop en jours (max 5 jours puis close market)
DAILY_TIME_STOP_DAYS=5
DAILY_FRIDAY_LATE_BLOCK_UTC=19:30
# Scan interval : 3600s = 1h, mais cycle effectif 1×/jour via cron
DAILY_SCAN_INTERVAL_SEC=3600
DAILY_STATE_PATH=/app/data/daily_state.json

# ─── Weekly swing trader (PR #37) ────────────────────────────────────
# Timeframe 1w, hold 2-4 semaines. Signaux rares, grands mouvements.
# Cycle unique cron dim 23:00 UTC (après close bougie 1w).
WEEKLY_ENABLED=false
WEEKLY_MODE=dry_run
# Bridge MT5 (par défaut IC Markets demo port 8787)
WEEKLY_BRIDGE_URL=http://100.74.160.72:8787
# Fallback automatique sur MT5_BRIDGE_API_KEY si vide
WEEKLY_BRIDGE_API_KEY=
# true pour routing canal demo 🟦, false pour canal ic_markets 🟩
WEEKLY_ACCOUNT_IS_DEMO=true
# Univers trading
WEEKLY_UNIVERSE=XAU/USD,EUR/USD,GBP/USD,USD/JPY
# Caps safety hebdo (plus large que daily car hold long)
WEEKLY_MAX_WEEKLY_LOSS_EUR=50.0
WEEKLY_MAX_POSITIONS=5
WEEKLY_RISK_PCT=1.0
# Indicateurs
WEEKLY_RSI_PERIOD=14
WEEKLY_RSI_LONG_THR=30
WEEKLY_RSI_SHORT_THR=70
# SL/TP wide pour swing long terme (2.5 ATR au lieu de 1.0 scalp)
WEEKLY_SL_ATR_MULT=2.5
WEEKLY_TP_R_MULT=2.5
WEEKLY_ATR_PERIOD=14
# Flag momentum : true = short les RSI<30, long les RSI>70
WEEKLY_INVERT_DIRECTION=false
# En mode momentum : TP = entry ± MOMENTUM_TP_R_MULT × distance_SL
WEEKLY_MOMENTUM_TP_R_MULT=2.0
# Time stop en JOURS (30j = ~6 semaines max)
WEEKLY_TIME_STOP_DAYS=30
# Cadence : 1×/semaine = 604800s
WEEKLY_SCAN_INTERVAL_SEC=604800
WEEKLY_STATE_PATH=/app/data/weekly_state.json
