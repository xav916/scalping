#!/bin/bash
# Check chaque minute que toutes les positions Live ont SL et TP non-nuls.
# Alerte Telegram infra immédiate si position naked détectée (sl=0 ou tp=0).
# Cron : * * * * * /opt/scalping/scripts/check-live-positions-sltp.sh >> /var/log/scalping/live-positions-sltp.log 2>&1
set -e

API_KEY="LfgTmroyi8Ik5u61lEQDAB3chWM90tNJ"
BRIDGE="http://100.74.160.72:8788"
TOKEN="shdw_diaY5ZBXM1b4CjdwzN8kd572-ylWcbIg"
NOTIFY="https://app.scalping-radar.online/api/admin/notify-infra-telegram?token=${TOKEN}"
STATE_DIR="/var/lib/scalping"
mkdir -p "$STATE_DIR"

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
RESP=$(curl -sS -m 6 -H "X-API-Key: $API_KEY" "$BRIDGE/positions" 2>/dev/null || echo "")

if [ -z "$RESP" ] || ! echo "$RESP" | grep -q '"count"'; then
  echo "$TS bridge unreachable — skip (monitor_live_bridge s'en charge)"
  exit 0
fi

# Parse via python (JSON safe)
NAKED=$(echo "$RESP" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    naked = [p for p in d.get("positions", []) if float(p.get("sl", 0)) == 0.0 or float(p.get("tp", 0)) == 0.0]
    for p in naked:
        print(f"{p['"'"'ticket'"'"']}|{p['"'"'symbol'"'"']}|{p['"'"'type'"'"']}|{p['"'"'volume'"'"']}|{p['"'"'price_open'"'"']}|{p['"'"'sl'"'"']}|{p['"'"'tp'"'"']}|{p['"'"'time'"'"']}")
except Exception as e:
    print(f"parse_error:{e}", file=sys.stderr)
' 2>/dev/null)

if [ -z "$NAKED" ]; then
  echo "$TS all positions have SL+TP OK"
  exit 0
fi

# One alert per naked position, dedup by ticket (cooldown 1h)
while IFS='|' read -r ticket sym typ vol popen sl tp t_open; do
  [ -z "$ticket" ] && continue
  echo "$TS NAKED position ticket=$ticket sym=$sym type=$typ sl=$sl tp=$tp"

  TITLE="🚨 Position Live SANS PROTECTION"
  BODY="Une position sur ton compte LIVE IC Markets est ouverte sans SL/TP.\n\n📋 Détail\nTicket : #${ticket}\nSymbole : ${sym} ${typ}\nVolume : ${vol}\nEntry : ${popen}\nSL : ${sl}\nTP : ${tp}\nOuvert : ${t_open}\n\n⚠️ ACTION\nOuvre MT5 Live → clic droit position → Modifier → ajouter SL et TP.\nSans SL, un gap peut vider ton compte."

  curl -sS -m 5 -X POST "$NOTIFY" \
    -H "Content-Type: application/json" \
    --data "{\"title\":\"$TITLE\",\"body\":\"$BODY\",\"dedup_key\":\"naked_live_${ticket}\",\"cooldown_seconds\":3600}" \
    > /dev/null || true
done <<< "$NAKED"
